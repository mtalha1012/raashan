{
  "name": "raashan",
  "version": "1.0.0",
  "description": "Raashan: MERN grocery delivery where the family WhatsApp list becomes one shared household list",
  "license": "ISC",
  "author": "Muhammad Talha",
  "type": "commonjs",
  "main": "backend/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "client": "npm run dev --prefix frontend",
    "build": "npm install --prefix frontend --include=dev && npm run build --prefix frontend",
    "seed": "node backend/scripts/seed.js",
    "make-admin": "node backend/scripts/makeAdmin.js",
    "test": "node --test \"backend/tests/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "nodemailer": "^10.0.10",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
