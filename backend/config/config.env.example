PORT=4000
DB_URI="mongodb://localhost:27017/Raashan"

# Use production to serve the frontend build
NODE_ENV=development
# Frontend URL for the reset password link
CLIENT_URL="http://localhost:5173"

# Use a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRE=5d
# Cookie lifetime in days
COOKIE_EXPIRE=7

# SMTP settings used by the forgot-password email
SMTP_SERVICE="gmail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL="your-email@gmail.com"
# For Gmail, use an App Password (not your account password)
SMTP_PASSWORD="your-app-password"
SMTP_FROM_NAME="Raashan"
