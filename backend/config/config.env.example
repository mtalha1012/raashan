PORT=4000
DB_URI="mongodb://localhost:27017/Raashan"

# "production" makes the server also serve the built frontend (frontend/dist)
NODE_ENV=development
# Where the frontend runs -- used for the reset-password link in emails
CLIENT_URL="http://localhost:5173"

# Use a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRE=5d
# Cookie lifetime in days
COOKIE_EXPIRE=7

# SMTP settings used by the forgot-password email (optional, everything else works without them)
SMTP_SERVICE="gmail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL="your-email@gmail.com"
# For Gmail, use an App Password (not your account password)
SMTP_PASSWORD="your-app-password"
SMTP_FROM_NAME="Raashan"
